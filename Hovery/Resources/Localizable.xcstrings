{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "comment" : "A problem with a setting's value, then the setting's description.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@"
          }
        }
      }
    },
    "%@ Settings" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”设置"
          }
        }
      }
    },
    "%@ contains native code that runs with your account’s access. Only allow it if you trust its source." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”包含原生代码，这些代码会以你的账户权限运行。请仅在信任其来源时允许。"
          }
        }
      }
    },
    "A choice needs at least one option." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "choice 类型的设置至少需要一个选项。"
